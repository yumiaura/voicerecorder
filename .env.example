# General
TZ=UTC

# Recording
RECORD_DIR=./data/recordings
SEGMENT_MINUTES=5
# PulseAudio source name (e.g. from scripts/mic_select.sh); default capture device if empty
PULSE_SOURCE=
SAMPLE_RATE=48000

# SQLite
SQLITE_PATH=./data/app.db
# Docker: SQLITE_PATH=/opt/app_data/app.db  and  RECORD_DIR=/opt/app_data/recordings

# Flask API
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Host port for Docker publish
API_PORT=5050
FLASK_DEBUG=1
# Same key signs JWT; change in any non-local use
SECRET_KEY=ChAnGeMe
# Local UI/API login (default admin / admin)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# JWT lifetime in hours
AUTH_JWT_HOURS=168

# STT
STT_ENABLED=0
STT_URL=http://localhost:5099
STT_INTERVAL_SEC=5
# Send WAV instead of OGG if the STT server does not support Ogg
STT_USE_WAV=0
STT_REQUEST_TIMEOUT_SEC=600
