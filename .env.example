# General
TZ=UTC

# Recording
RECORD_DIR=./data/recordings
SEGMENT_MINUTES=5
# PulseAudio source name (e.g. from scripts/mic_select.sh); default capture device if empty
PULSE_SOURCE=
# Recorder input backend: pulse or alsa
RECORDER_INPUT=alsa
# ALSA capture device (from `arecord -l`, for card2/device0 use plughw:2,0)
ALSA_DEVICE=plughw:2,0
# Input channels for capture device (USB mics are often mono=1)
RECORDER_CHANNELS=1
# Host PulseAudio UNIX socket for recorder container
PULSE_SOCKET=/run/user/1000/pulse/native
# Host PulseAudio cookie for recorder container auth
PULSE_COOKIE=/home/aura/.config/pulse/cookie
# UID/GID used to run worker container (must match desktop user)
LOCAL_UID=1000
LOCAL_GID=1000
SAMPLE_RATE=48000

# SQLite
SQLITE_PATH=./data/app.db
# Docker: SQLITE_PATH=/opt/app_data/app.db  and  RECORD_DIR=/opt/app_data/recordings

# Logging
# Rotating log files; defaults to the "logs" folder next to RECORD_DIR
LOG_DIR=./data/logs
# Size of a single log file before it rotates, in bytes (10 MiB)
LOG_MAX_BYTES=10485760
# How many rotated files to keep
LOG_BACKUP_COUNT=5

# Flask API
FLASK_HOST=0.0.0.0
FLASK_PORT=5010
# Host port for Docker publish
API_PORT=5010
# Frontend (separate www container) host port
WWW_PORT=5011
FLASK_DEBUG=1
# Same key signs JWT; change in any non-local use
SECRET_KEY=ChAnGeMe
# Local UI/API login (default admin / admin)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# JWT lifetime in hours
AUTH_JWT_HOURS=168

# STT
STT_ENABLED=0
STT_URL=http://localhost:5099
STT_INTERVAL_SEC=5
# Send WAV instead of OGG if the STT server does not support Ogg
STT_USE_WAV=0
STT_REQUEST_TIMEOUT_SEC=600
